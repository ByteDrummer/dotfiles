#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d I II III IV V VI VII VIII IX X

bspc config border_width         0
bspc config window_gap          12

bspc config pointer_motion_interval 7 # 144 hz window movement

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config pointer_follows_focus true
bspc config focus_follows_pointer true

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a firefox desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Yad state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
bspc rule -a thunderbird desktop='^1'
bspc rule -a "*:crx_kjbdgfilnfhdoflbpgamdcdgpehopbep" desktop='^1'
bspc rule -a "*:crx_mgamiaabcidhdjkgbmmalofnegcnbbpi" desktop='^2'
bspc rule -a discord desktop='^2'


# Border
bspc config focused_border_color        "#aab2bf"
bspc config normal_border_color         "#aab2bf"
bspc config active_border_color         "#aab2bf"
bspc config presel_feedback_color       "#aab2bf"

#
# Autostart
#
# Set display from arandr saved script
sh ~/.screenlayout/monitor.sh &
# Bar
~/.config/polybar/launch.sh &
# Notifications
/usr/bin/dunst &
# Polkit
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
# Wallpaper
feh --bg-scale /home/eric/Pictures/Wallpapers/main.jpg &
# Dex
dex -a -s /etc/xdg/autostart/:~/.config/autostart/  &
# Picom
picom -b &
# Network Applet
nm-applet --indicator &
# IMWHeel for scrolling
imwheel -b "45" &
# Power management
xfce4-power-manager &
# Cursor
xsetroot -cursor_name left_ptr &
# Low battery notifier
~/.config/bspwm/scripts/low_bat_notifier.sh &
# Apply border to marked window
~/.config/bspwm/scripts/marked_window.sh &
# Automatic screen locking on suspend or screen timeout
xss-lock ~/.config/bspwm/scripts/i3lock-fancy/i3lock-fancy.sh &
